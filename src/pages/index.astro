<!-- ══════════════════════ Scripts ═══════════════════════════════════════════ -->
<script is:inline>
(function () {
  // ── Reveal on scroll ────────────────────────────────────────────────────
  function initReveal() {
    var els = document.querySelectorAll('.reveal-up');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) {
          var delay = parseInt(e.target.style.getPropertyValue('--delay')) || 0;
          setTimeout(function(){ e.target.classList.add('is-visible'); }, delay);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -40px 0px' });
    els.forEach(function(el){ io.observe(el); });
  }

  // ── UUID search ─────────────────────────────────────────────────────────
  function initSearch() {
    var form  = document.getElementById('search-form');
    var input = document.getElementById('match-id-input');
    var err   = document.getElementById('uuid-error');
    if (!form) return;
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var v = (input.value || '').trim();
      var ok = /^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$/.test(v);
      if (ok) {
        if (err) err.classList.add('hidden');
        window.location.href = '/partido/' + v;
      } else {
        if (err) err.classList.remove('hidden');
        input.focus();
      }
    });
  }

  // ── Burger menu ─────────────────────────────────────────────────────────
  function initBurger() {
    var btn = document.getElementById('burger');
    var nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function(){
      btn.classList.toggle('open');
      nav.classList.toggle('open');
    });
    nav.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){
        btn.classList.remove('open');
        nav.classList.remove('open');
      });
    });
  }

  // ── Header shrink on scroll ─────────────────────────────────────────────
  function initHeaderScroll() {
    var hdr = document.querySelector('.site-header');
    if (!hdr) return;
    window.addEventListener('scroll', function(){
      hdr.classList.toggle('scrolled', window.scrollY > 40);
    }, { passive: true });
  }

  // ── Bouncing Ball ───────────────────────────────────────────────────────
  function initBouncingBall() {
    if (window.innerWidth < 768) return;
    
    var ballSize = 24;
    var numTrails = 12;
    var speedOriginal = 4;
    var speed = speedOriginal;

    var wrapper = document.createElement('div');
    wrapper.className = 'padel-bounce-wrapper';
    var visual = document.createElement('div');
    visual.className = 'padel-bounce-visual';
    wrapper.appendChild(visual);
    
    var trails = [];
    for (var i = 0; i < numTrails; i++) {
      var t = document.createElement('div');
      t.className = 'padel-bounce-trail';
      document.body.appendChild(t);
      trails.push({ el: t });
    }
    document.body.appendChild(wrapper);

    var x = Math.random() * (window.innerWidth - ballSize);
    var y = Math.random() * (window.innerHeight - ballSize);
    var angle = Math.random() * Math.PI * 2;
    var vx = Math.cos(angle) * speed;
    var vy = Math.sin(angle) * speed;
    var history = [];

    function update() {
      x += vx;
      y += vy;

      var maxX = document.documentElement.scrollWidth - ballSize;
      var maxY = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight) - ballSize;

      if (x <= 0) { x = 0; vx *= -1; }
      if (x >= maxX) { x = maxX; vx *= -1; }
      if (y <= 0) { y = 0; vy *= -1; }
      if (y >= maxY) { y = maxY; vy *= -1; }

      var scrollY = window.scrollY;

      var renderX = x - window.scrollX;
      var renderY = y - window.scrollY;
      wrapper.style.transform = 'translate3d(' + renderX + 'px, ' + renderY + 'px, 0)';

      history.unshift({ x: x, y: y });
      if (history.length > numTrails) history.pop();

      for (var i = 0; i < trails.length; i++) {
        var pos = history[i] || history[history.length - 1] || { x: x, y: y };
        var scale = 1 - (i / numTrails);
        var opacity = 0.6 * (1 - (i / numTrails));
        trails[i].el.style.transform = 'translate3d(' + (pos.x - window.scrollX) + 'px, ' + (pos.y - window.scrollY) + 'px, 0) scale(' + scale + ')';
        trails[i].el.style.opacity = opacity;
      }

      if (speed > speedOriginal) {
        speed *= 0.98;
        var currentSpeed = Math.sqrt(vx*vx + vy*vy);
        vx = (vx / currentSpeed) * speed;
        vy = (vy / currentSpeed) * speed;
      }

      requestAnimationFrame(update);
    }

    wrapper.addEventListener('mouseenter', function(e) {
      var rect = wrapper.getBoundingClientRect();
      var cx = rect.left + rect.width / 2;
      var cy = rect.top + rect.height / 2;
      
      var dx = cx - e.clientX;
      var dy = cy - e.clientY;
      
      if (dx === 0 && dy === 0) {
        dx = Math.random() - 0.5;
        dy = Math.random() - 0.5;
      }

      var dist = Math.sqrt(dx*dx + dy*dy);
      
      speed = speedOriginal * 3.5; 
      vx = (dx / dist) * speed;
      vy = (dy / dist) * speed;

      visual.classList.add('hit');
      setTimeout(function(){ visual.classList.remove('hit'); }, 150);
    });

    requestAnimationFrame(update);
  }

  // ── Boot ────────────────────────────────────────────────────────────────
  function boot() {
    initReveal();
    initSearch();
    initBurger();
    initHeaderScroll();
    initBouncingBall();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else { boot(); }
})();
</script>

