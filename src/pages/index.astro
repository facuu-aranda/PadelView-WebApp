---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/es';
---

<Layout title="ViewPadel — Grabación y distribución automática de partidos de pádel">

  <!-- ── Tech Sports Background Grid ── -->
  <div class="page-bg" aria-hidden="true">
    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>
    <div class="bg-orb orb-3"></div>
    <!-- Court floor abstract lines -->
    <div class="court-lines">
      <div class="court-line vertical center-line"></div>
      <div class="court-line horizontal service-line"></div>
    </div>
    <div class="grid-lines"></div>
  </div>

  <!-- ═══════════════ HEADER ═══════════════════════════════════════════════ -->
  <header class="site-header" id="top">
    <div class="header-inner">
      <a href="/" class="logo-link" aria-label="ViewPadel inicio">
        <img src="/View-padel.png" alt="ViewPadel" class="logo-img glow-effect" />
        <span class="logo-text">ViewPadel</span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#como-funciona">{ui.nav.howItWorks}</a>
        <a href="#busca-tu-partido">{ui.nav.yourMatch}</a>
        <a href="#planes">{ui.nav.pricing}</a>
        <a href="#soporte">{ui.nav.contact}</a>
      </nav>
      <a
        href="https://wa.me/5493564575862?text=Hola!%20Me%20interesa%20ViewPadel."
        target="_blank" rel="noopener"
        class="header-cta"
      >{ui.nav.sales}</a>
      <button class="burger" id="burger" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Menú móvil">
      <a href="#como-funciona" class="mob-link">{ui.nav.howItWorks}</a>
      <a href="#busca-tu-partido" class="mob-link">{ui.nav.yourMatch}</a>
      <a href="#planes" class="mob-link">{ui.nav.pricing}</a>
      <a href="#soporte" class="mob-link">{ui.nav.contact}</a>
    </nav>
  </header>

  <!-- ═══════════════ HERO ══════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero-content">
      <!-- Left copy -->
      <div class="hero-copy reveal-up">
        <div class="hero-badge tech-badge">
          <span class="badge-dot"></span>
          {ui.hero.badge}
        </div>
        <h1 class="hero-h1">
          {ui.hero.titleLine1}<br/>
          <span class="gradient-text">{ui.hero.titleHighlight}</span><br/>
          {ui.hero.titleLine2}
        </h1>
        <p class="hero-sub">
          {ui.hero.subtitle}
        </p>
        <div class="hero-actions">
          <a href="#planes" class="btn primary glass-glow">{ui.hero.ctaPrimary}</a>
          <a href="#como-funciona" class="btn ghost tech-border">{ui.hero.ctaSecondary}</a>
        </div>
        <!-- Trust strip -->
        <div class="trust-row">
          <div class="trust-item">
            <strong>{ui.hero.trust1}</strong><span>{ui.hero.trust1Sub}</span>
          </div>
          <div class="trust-divider"></div>
          <div class="trust-item">
            <strong>{ui.hero.trust2}</strong><span>{ui.hero.trust2Sub}</span>
          </div>
          <div class="trust-divider"></div>
          <div class="trust-item">
            <strong>{ui.hero.trust3}</strong><span>{ui.hero.trust3Sub}</span>
          </div>
        </div>
      </div>

      <!-- Right — Hero phone mockup -->
      <div class="hero-visual reveal-up" style="--delay:180ms">
        <div class="phone-wrap tall-phone-wrap">
          <!-- Ambient glows behind phone -->
          <div class="phone-glow glow-a"></div>
          <div class="phone-glow glow-b"></div>

          <!-- The phone (Taller proportions) -->
          <div class="iphone tall-iphone">
            <div class="iphone-island"></div>
            <div class="iphone-screen">

              <!-- Status bar -->
              <div class="iphone-statusbar">
                <span>9:41</span>
                <div class="sb-icons">
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><rect x="0" y="3" width="3" height="7" rx="1" fill="white" opacity=".4"/><rect x="4" y="2" width="3" height="8" rx="1" fill="white" opacity=".6"/><rect x="8" y="0" width="3" height="10" rx="1" fill="white" opacity=".8"/><rect x="12" y="0" width="2" height="10" rx="1" fill="white"/></svg>
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M2 5C3.6 2.2 6.8 1 7 1s3.4 1.2 5 4c-1.6 2.8-4.8 4-5 4S3.6 7.8 2 5Z" stroke="white" stroke-width="1.2" fill="none" opacity=".8"/><circle cx="7" cy="5" r="1.5" fill="white"/></svg>
                  <svg width="16" height="10" viewBox="0 0 16 10" fill="none"><rect x="0.5" y="0.5" width="13" height="9" rx="2.5" stroke="white" stroke-opacity=".4"/><rect x="1.5" y="1.5" width="9" height="7" rx="1.5" fill="white"/><path d="M14 3.5v3a1.5 1.5 0 0 0 0-3Z" fill="white" opacity=".4"/></svg>
                </div>
              </div>

              <!-- Header bar -->
              <div class="iphone-app-header">
                <img src="/View-padel.png" alt="VP" class="app-logo-small glow-effect" />
                <span class="app-title">ViewPadel</span>
                <svg class="app-share" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>
              </div>

              <!-- Video player area -->
              <div class="iphone-player">
                <div class="player-court-bg">
                  <!-- Padel court SVG illustration -->
                  <svg class="court-svg" viewBox="0 0 280 160" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="280" height="160" fill="#0b172a"/>
                    <!-- Court floor -->
                    <rect x="20" y="30" width="240" height="120" rx="2" fill="#132c52" stroke="#38bdf8" stroke-width="1.2" stroke-opacity="0.5"/>
                    <!-- Center line -->
                    <line x1="140" y1="30" x2="140" y2="150" stroke="#38bdf8" stroke-width="0.8" stroke-opacity="0.6"/>
                    <!-- Service box lines -->
                    <line x1="20" y1="90" x2="260" y2="90" stroke="#38bdf8" stroke-width="0.8" stroke-opacity="0.5"/>
                    <!-- Net -->
                    <rect x="135" y="30" width="10" height="120" fill="#0ea5e9" opacity="0.3"/>
                    <line x1="140" y1="30" x2="140" y2="150" stroke="#38bdf8" stroke-width="2" stroke-opacity="0.9"/>
                    <!-- Ball -->
                    <circle cx="90" cy="75" r="8" fill="#00ff87" opacity="0.9">
                      <animateMotion dur="3s" repeatCount="indefinite" calcMode="spline" keySplines="0.4 0 0.6 1; 0.4 0 0.6 1">
                        <mpath href="#ball-path"/>
                      </animateMotion>
                    </circle>
                    <path id="ball-path" d="M90 75 Q180 40 180 80 Q180 120 90 95 Q90 75 90 75" fill="none"/>
                    <!-- Players silhouettes -->
                    <ellipse cx="80" cy="140" rx="12" ry="5" fill="#0f172a" opacity="0.8"/>
                    <rect x="74" y="108" width="12" height="30" rx="4" fill="#0284c7" opacity="0.8"/>
                    <circle cx="80" cy="103" r="7" fill="#0ea5e9" opacity="0.9"/>
                    
                    <ellipse cx="200" cy="140" rx="12" ry="5" fill="#0f172a" opacity="0.8"/>
                    <rect x="194" y="108" width="12" height="30" rx="4" fill="#7c3aed" opacity="0.8"/>
                    <circle cx="200" cy="103" r="7" fill="#a855f7" opacity="0.9"/>
                  </svg>
                  <!-- Play button overlay -->
                  <button class="play-btn tech-play" aria-label="Reproducir">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </button>
                  <!-- Live badge -->
                  <div class="rec-badge">
                    <span class="rec-dot"></span> GRABANDO
                  </div>
                  <!-- Progress bar -->
                  <div class="player-progress">
                    <div class="progress-bar">
                      <div class="progress-fill"></div>
                    </div>
                    <div class="progress-times">
                      <span>32:14</span><span>01:24:00</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Info card -->
              <div class="iphone-info-card">
                <div class="info-left">
                  <div class="info-court-tag">Cancha 3</div>
                  <div class="info-match-name">Juan P. &amp; Diego M.</div>
                  <div class="info-date">Hoy · 16:30 hs</div>
                </div>
                <div class="info-actions">
                  <button class="info-action-btn download">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                  </button>
                  <button class="info-action-btn share">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                  </button>
                </div>
              </div>

              <!-- Filler to push notification down in taller phone -->
              <div class="iphone-spacer"></div>

              <!-- WhatsApp notification pill -->
              <div class="iphone-notif">
                <div class="notif-app-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
                </div>
                <div class="notif-text">
                  <div class="notif-title">ViewPadel</div>
                  <div class="notif-body">Tu partido está listo 🎾 Ver ahora →</div>
                </div>
                <div class="notif-time">ahora</div>
              </div>

            </div><!-- /iphone-screen -->
          </div><!-- /iphone -->

          <!-- Floating detail badges -->
          <div class="float-badge badge-hd tech-border">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4Z"/></svg>
            Full HD
          </div>
          <div class="float-badge badge-auto tech-border">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            Automático
          </div>
          <div class="float-badge badge-wp tech-border">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
            WhatsApp
          </div>
        </div><!-- /phone-wrap -->
      </div><!-- /hero-visual -->
    </div><!-- /hero-content -->

    <!-- Scroll indicator -->
    <div class="scroll-cue">
      <div class="scroll-line"></div>
      <span>{ui.hero.scroll}</span>
    </div>
  </section>

  <!-- ═══════════════ FEATURES BENTO ═══════════════════════════════════════ -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-label reveal-up">{ui.features.label}</div>
      <h2 class="section-h2 reveal-up" style="--delay:60ms">{ui.features.title1}<br/>{ui.features.title2}</h2>
      <div class="bento-grid">

        <div class="bento-card bento-wide tech-bento reveal-up" style="--delay:100ms">
          <div class="bento-icon cyan">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M23 7 16 12 23 17V7Z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          </div>
          <h3>{ui.features.camTitle}</h3>
          <p>{ui.features.camDesc}</p>
          <div class="bento-decoration">
            <div class="cam-indicator">
              <span class="cam-dot"></span>
              <span class="cam-label">REC</span>
            </div>
          </div>
        </div>

        <div class="bento-card tech-bento reveal-up" style="--delay:160ms">
          <div class="bento-icon green">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3>{ui.features.uploadTitle}</h3>
          <p>{ui.features.uploadDesc}</p>
        </div>

        <div class="bento-card tech-bento reveal-up" style="--delay:200ms">
          <div class="bento-icon purple">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.84a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16a2 2 0 0 1 .27.92Z"/></svg>
          </div>
          <h3>{ui.features.linkTitle}</h3>
          <p>{ui.features.linkDesc}</p>
        </div>

        <div class="bento-card tech-bento reveal-up" style="--delay:240ms">
          <div class="bento-icon amber">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 2 11 13M22 2 15 22 11 13 2 9l20-7Z"/></svg>
          </div>
          <h3>{ui.features.viralTitle}</h3>
          <p>{ui.features.viralDesc}</p>
        </div>

        <div class="bento-card bento-wide tech-bento reveal-up" style="--delay:280ms">
          <div class="bento-icon rose">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
          </div>
          <h3>{ui.features.coverageTitle}</h3>
          <p>{ui.features.coverageDesc}</p>
          <div class="coverage-bar-group">
            <div class="coverage-bar" style="--w:95%; --c:#00f2fe">
              <span>{ui.features.coverageStat}</span><div class="bar"><div class="bar-fill glow-fill"></div></div><span class="stat-num">95%</span>
            </div>
            <div class="coverage-bar" style="--w:100%; --c:#00ff87">
              <span>{ui.features.uptimeStat}</span><div class="bar"><div class="bar-fill glow-fill"></div></div><span class="stat-num">99.9%</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════ HOW IT WORKS ══════════════════════════════════════════ -->
  <section class="section tech-stripe-bg" id="como-funciona">
    <div class="container">
      <div class="section-label reveal-up">{ui.howItWorks.label}</div>
      <h2 class="section-h2 reveal-up" style="--delay:60ms">{ui.howItWorks.title1}<br/>{ui.howItWorks.title2}</h2>

      <div class="steps-container tech-border">
        <div class="step-item reveal-up" style="--delay:100ms">
          <div class="step-number">01</div>
          <div class="step-body">
            <h4>{ui.howItWorks.step1Title}</h4>
            <p>{ui.howItWorks.step1Desc}</p>
          </div>
          <div class="step-arrow">→</div>
        </div>
        <div class="step-item reveal-up" style="--delay:180ms">
          <div class="step-number">02</div>
          <div class="step-body">
            <h4>{ui.howItWorks.step2Title}</h4>
            <p>{ui.howItWorks.step2Desc}</p>
          </div>
          <div class="step-arrow">→</div>
        </div>
        <div class="step-item reveal-up" style="--delay:260ms">
          <div class="step-number">03</div>
          <div class="step-body">
            <h4>{ui.howItWorks.step3Title}</h4>
            <p>{ui.howItWorks.step3Desc}</p>
          </div>
          <div class="step-arrow final">✓</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ SHOWCASE SPLIT ════════════════════════════════════════ -->
  <section class="section showcase-section">
    <div class="container">
      <div class="showcase-split reveal-up">

        <!-- Second phone mockup — the player view -->
        <div class="showcase-phones">
          <div class="phone-back-card tech-card">
            <!-- Stacked UI card behind phone -->
            <div class="back-card-ui">
              <div class="bcu-header">
                <div class="bcu-dot red"></div>
                <div class="bcu-dot amber"></div>
                <div class="bcu-dot green"></div>
                <span style="font-size:11px; color:#4a5568; margin-left:8px;">viewpadel.app/partido/...</span>
              </div>
              <div class="bcu-content">
                <div class="bcu-row">
                  <div class="bcu-thumb"></div>
                  <div class="bcu-info">
                    <div class="bcu-title"></div>
                    <div class="bcu-sub"></div>
                  </div>
                </div>
                <div class="bcu-bar b1"></div>
                <div class="bcu-bar b2"></div>
                <div class="bcu-bar b3" style="width:55%"></div>
              </div>
            </div>
          </div>

          <!-- Front phone (Taller proportions) -->
          <div class="iphone tall-iphone showcase-iphone tech-border">
            <div class="iphone-island"></div>
            <div class="iphone-screen">
              <div class="iphone-statusbar dark">
                <span>9:41</span>
                <div class="sb-icons">
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><rect x="0" y="3" width="3" height="7" rx="1" fill="white" opacity=".4"/><rect x="4" y="2" width="3" height="8" rx="1" fill="white" opacity=".6"/><rect x="8" y="0" width="3" height="10" rx="1" fill="white" opacity=".8"/><rect x="12" y="0" width="2" height="10" rx="1" fill="white"/></svg>
                  <svg width="16" height="10" viewBox="0 0 16 10" fill="none"><rect x="0.5" y="0.5" width="13" height="9" rx="2.5" stroke="white" stroke-opacity=".4"/><rect x="1.5" y="1.5" width="9" height="7" rx="1.5" fill="white"/><path d="M14 3.5v3a1.5 1.5 0 0 0 0-3Z" fill="white" opacity=".4"/></svg>
                </div>
              </div>
              <div class="showcase-screen-content">
                <img src="/View-padel.png" alt="VP" class="ssc-logo glow-effect" />
                <div class="ssc-label">{ui.showcase.screenStatusReady}</div>
                <div class="ssc-video-thumb">
                  <svg viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%; height:100%; border-radius:10px;">
                    <rect width="200" height="110" fill="#0f2744"/>
                    <rect x="10" y="10" width="180" height="90" rx="1" fill="#1a3a6b" stroke="#2563eb" stroke-width="0.8" stroke-opacity="0.4"/>
                    <line x1="100" y1="10" x2="100" y2="100" stroke="#2563eb" stroke-width="0.6" stroke-opacity="0.5"/>
                    <line x1="10" y1="55" x2="190" y2="55" stroke="#2563eb" stroke-width="0.6" stroke-opacity="0.4"/>
                    <line x1="100" y1="10" x2="100" y2="100" stroke="#60a5fa" stroke-width="1.5" stroke-opacity="0.8"/>
                    <circle cx="60" cy="40" r="5" fill="#00ff87" opacity="0.9" style="filter: drop-shadow(0 0 4px #00ff87)"/>
                    <circle cx="100" cy="55" r="30" fill="white" fill-opacity="0.06" stroke="white" stroke-opacity="0.1"/>
                    <path d="M94 48 L94 62 L108 55 Z" fill="white" opacity="0.9"/>
                  </svg>
                </div>
                <div class="ssc-match-name">{ui.showcase.screenMatchName}</div>
                <div class="ssc-date">{ui.showcase.screenMatchDate}</div>
                <div class="ssc-buttons">
                  <button class="ssc-btn-primary">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                    {ui.showcase.screenBtnDownload}
                  </button>
                  <button class="ssc-btn-ghost">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                    {ui.showcase.screenBtnShare}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Copy -->
        <div class="showcase-copy reveal-up" style="--delay:120ms">
          <div class="section-label" style="text-align:left; margin-bottom:16px;">{ui.showcase.label}</div>
