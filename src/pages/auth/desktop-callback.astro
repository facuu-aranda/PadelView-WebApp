---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Autenticación Exitosa - ViewPadel">
  <main class="min-h-screen bg-gray-900 flex items-center justify-center p-4 font-sans">
    <div class="bg-gray-800 border border-gray-700 rounded-2xl p-8 max-w-md w-full text-center shadow-2xl relative overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-64 h-64 bg-[#a1f65e] rounded-full blur-[100px] opacity-20 pointer-events-none"></div>

      <div class="relative z-10">
        <div class="w-20 h-20 bg-[#a1f65e]/10 rounded-full flex items-center justify-center mx-auto mb-6 border border-[#a1f65e]/30">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#a1f65e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        
        <h1 class="text-3xl font-bold text-white mb-3">¡Inicio de Sesión Exitoso!</h1>
        <p class="text-gray-300 text-lg mb-8 leading-relaxed">
          Ya hemos verificado tu cuenta. Te estamos redirigiendo automáticamente a la aplicación de ViewPadel.
        </p>

        <div class="space-y-4">
          <div class="flex items-center justify-center space-x-2 text-[#a1f65e]">
            <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="font-medium">Abriendo aplicación...</span>
          </div>
          
          <div class="pt-4 mt-6 border-t border-gray-700/50">
            <p class="text-sm text-gray-400">
              ¿No se abre automáticamente? <br/>
              Asegúrate de permitir que el navegador abra ViewPadel. Puedes cerrar esta pestaña con seguridad.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Al cargar la página en el cliente
    document.addEventListener('DOMContentLoaded', () => {
      // Supabase OAuth manda los tokens en el hash de la URL (#access_token=...)
      // o a veces en los query params (?code=...)
      const hash = window.location.hash;
      const search = window.location.search;
      
      // Armamos la URL profunda (deep link) hacia nuestra app de escritorio
      // viewpadel://login#access_token=... o viewpadel://login?code=...
      const deepLink = `viewpadel://login${search}${hash}`;
      
      // Intentamos redireccionar a la app inmediatamente
      window.location.href = deepLink;
    });
  </script>
</Layout>
