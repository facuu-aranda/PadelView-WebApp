---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../i18n/es';
---

<Layout title="Autenticación Exitosa - ViewPadel">

  <!-- ── Tech Sports Background Grid ── -->
  <div class="page-bg" aria-hidden="true">
    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>
    <div class="bg-orb orb-3"></div>
    <!-- Court floor abstract lines -->
    <div class="court-lines">
      <div class="court-line vertical center-line"></div>
      <div class="court-line horizontal service-line"></div>
    </div>
    <div class="grid-lines"></div>
  </div>

  <!-- ═══════════════ HEADER ═══════════════════════════════════════════════ -->
  <header class="site-header" id="top">
    <div class="header-inner">
      <a href="/" class="logo-link" aria-label="ViewPadel inicio">
        <img src="/View-padel.png" alt="ViewPadel" class="logo-img glow-effect" />
        <span class="logo-text">ViewPadel</span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="/#como-funciona">{ui.nav.howItWorks}</a>
        <a href="/#busca-tu-partido">{ui.nav.yourMatch}</a>
        <a href="/#planes">{ui.nav.pricing}</a>
        <a href="/#soporte">{ui.nav.contact}</a>
      </nav>
      
      <div class="header-actions" style="display: flex; gap: 10px; align-items: center;">
        <a href="https://github.com/facuu-aranda/PadelView-DesktopApp/releases/latest/download/ViewPadel-Setup.exe" class="header-cta download">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          {ui.nav.downloadApp}
        </a>
      </div>
      <button class="burger" id="burger" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Menú móvil">
      <a href="/#como-funciona" class="mob-link">{ui.nav.howItWorks}</a>
      <a href="/#busca-tu-partido" class="mob-link">{ui.nav.yourMatch}</a>
      <a href="/#planes" class="mob-link">{ui.nav.pricing}</a>
      <a href="/#soporte" class="mob-link">{ui.nav.contact}</a>
    </nav>
  </header>

  <!-- ═══════════════ CONTENT ══════════════════════════════════════════════ -->
  <section class="callback-section">
    <div class="callback-card glow-panel reveal-up">
      <div class="icon-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </div>
      
      <h1 class="gradient-text">¡Inicio de Sesión Exitoso!</h1>
      <p class="callback-sub">
        Ya hemos verificado tu cuenta. Te estamos redirigiendo automáticamente a la aplicación de ViewPadel.
      </p>

      <div class="loader-container">
        <svg class="spinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Abriendo aplicación...</span>
      </div>
      
      <div class="callback-footer">
        ¿No se abre automáticamente? <br/>
        Asegúrate de permitir que el navegador abra ViewPadel. Puedes cerrar esta pestaña con seguridad.
      </div>
    </div>
  </section>

  <script>
    // Header burger logic (same as index)
    document.addEventListener('DOMContentLoaded', () => {
      const burger = document.getElementById('burger');
      const mobileNav = document.getElementById('mobile-nav');
      if (burger && mobileNav) {
        burger.addEventListener('click', () => {
          burger.classList.toggle('active');
          mobileNav.classList.toggle('open');
        });
      }

      // Redirection logic
      const hash = window.location.hash;
      const search = window.location.search;
      const deepLink = `viewpadel://login${search}${hash}`;
      
      // Intentamos redireccionar a la app inmediatamente
      setTimeout(() => {
        window.location.href = deepLink;
      }, 1000);
    });
  </script>

  <style>
    /* Basic Tokens just in case */
    :root {
      --cyan:   #00f2fe;
      --green:  #00ff87;
      --bg:     #0d1117;
      --surface:#0f1923;
      --border: rgba(255,255,255,0.07);
      --text:   #f0f6fc;
      --muted:  #cbd5e1;
    }

    /* Reuse some index.astro background styles to ensure it looks the same */
    .page-bg {
      position: fixed; inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      background-color: var(--bg);
    }
    .bg-orb {
      position: absolute;
      border-radius: 50%;
      opacity: 0.4;
      will-change: transform;
    }
    .orb-1 {
      width: 700px; height: 700px;
      background: radial-gradient(circle, var(--cyan) 0%, transparent 70%);
      top: -200px; right: -100px;
      animation: orb-drift 18s ease-in-out infinite alternate;
    }
    .orb-2 {
      width: 600px; height: 600px;
      background: radial-gradient(circle, var(--green) 0%, transparent 70%);
      bottom: -150px; left: -100px;
      animation: orb-drift 15s ease-in-out infinite alternate-reverse;
      opacity: 0.25;
    }
    .orb-3 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, #3b82f6 0%, transparent 70%);
      top: 40%; left: 30%;
      animation: orb-drift 22s ease-in-out infinite alternate;
      opacity: 0.15;
    }

    /* Missing lines from landing page */
    .court-lines {
      position: absolute; inset: 0; opacity: 0.05;
      display: flex; align-items: center; justify-content: center;
    }
    .court-line { background: #fff; position: absolute; }
    .court-line.vertical { width: 2px; height: 100vh; left: 50%; }
    .court-line.horizontal { width: 100vw; height: 2px; top: 75%; }

    .grid-lines {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
    }

    .callback-section {
      position: relative;
      z-index: 10;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 100px 20px 40px; /* Offset header */
    }

    .callback-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 3rem 2rem;
      max-width: 440px; /* Reduced width */
      width: 100%;
      text-align: center;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      position: relative;
      overflow: hidden;
    }

    .icon-wrapper {
      width: 100px;
      height: 100px;
      background: rgba(0, 242, 254, 0.05);
      border: 1px solid rgba(0, 242, 254, 0.2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 2rem;
      box-shadow: 0 0 30px rgba(0, 242, 254, 0.1);
    }

    .gradient-text {
      background: linear-gradient(to right, var(--cyan), var(--green));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .callback-sub {
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.6;
      margin-bottom: 2.5rem;
    }

    .loader-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      color: var(--cyan);
      font-weight: 500;
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }

    .spinner {
      animation: spin 1s linear infinite;
      width: 24px;
      height: 24px;
    }
    
    .opacity-25 { opacity: 0.25; }
    .opacity-75 { opacity: 0.75; }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .callback-footer {
      border-top: 1px solid var(--border);
      padding-top: 1.5rem;
      color: #8b949e;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    /* Keep header CSS identical to index if it's not global */
    .site-header {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 100;
      background: rgba(13,17,23,0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      transition: all 0.3s;
    }
    .header-inner {
      max-width: 1200px; margin: 0 auto;
      height: 70px;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 20px;
    }
    .logo-link { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .logo-img { width: 32px; height: 32px; border-radius: 8px; }
    .logo-text { font-size: 1.25rem; font-weight: 700; color: var(--text); letter-spacing: -0.5px; }
    .desktop-nav { display: none; gap: 32px; }
    .desktop-nav a { text-decoration: none; color: var(--muted); font-size: 0.95rem; font-weight: 500; transition: color 0.2s; }
    .desktop-nav a:hover { color: var(--cyan); }
    
    .header-cta {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 8px 16px; border-radius: 8px;
      font-size: 0.9rem; font-weight: 600; text-decoration: none;
      transition: all 0.2s;
      background: rgba(255,255,255,0.05); color: var(--text);
      border: 1px solid var(--border);
    }
    .header-cta:hover { background: rgba(255,255,255,0.1); }
    .header-cta.download { background: var(--text); color: var(--bg); border: none; }
    .header-cta.download:hover { opacity: 0.9; transform: translateY(-1px); }
    
    .burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 5px; }
    .burger span { display: block; width: 24px; height: 2px; background: var(--text); transition: 0.3s; }
    
    .mobile-nav {
      position: absolute; top: 70px; left: 0; right: 0;
      background: var(--surface); border-bottom: 1px solid var(--border);
      display: flex; flex-direction: column;
      padding: 0; max-height: 0; overflow: hidden;
      transition: max-height 0.3s ease;
      box-shadow: 0 10px 20px rgba(0,0,0,0.5);
    }
    .mobile-nav.open { max-height: 400px; padding: 10px 0 20px; }
    .mob-link { padding: 12px 20px; text-decoration: none; color: var(--text); font-weight: 500; }
    .mob-link:active { background: rgba(255,255,255,0.05); }

    @media (min-width: 900px) {
      .desktop-nav { display: flex; }
      .header-actions { display: flex; }
    }
    @media (max-width: 899px) {
      .header-actions { display: none; }
      .burger { display: flex; }
    }
  </style>
</Layout>
