---
import Layout from '../../layouts/Layout.astro';
import { getSupabase, getSignedVideoUrl } from '../../lib/server-services';
import AlertTriangle from '../../components/icons/AlertTriangle.astro';
import Download from '../../components/icons/Download.astro';
import LinkIcon from '../../components/icons/Link.astro';
import Zap from '../../components/icons/Zap.astro';

const { match_id } = Astro.params;

let match: any = null;
let signedUrl: string | null = null;
let errorMessage: string | null = null;
let isLoadingState = false;

try {
  if (!match_id) {
    throw new Error('Identificador de partido no especificado.');
  }

  const supabase = getSupabase();
  const { data, error } = await supabase
    .from('matches')
    .select('*, courts(name)')
    .eq('id', match_id)
    .single();

  if (error || !data) {
    console.error('Database query error:', error);
    errorMessage = 'El partido no existe o el enlace es incorrecto.';
  } else {
    match = data;
    
    if (match.status === 'DONE') {
      if (!match.video_key) {
        errorMessage = 'El video fue procesado pero no se encuentra en el almacenamiento.';
      } else if (!match.profile_id) {
        errorMessage = 'Este partido no está asociado a ningún club.';
      } else {
        // Fetch specific client configs to know which bucket and credentials to use
        const { data: config, error: configErr } = await supabase
          .from('client_configs')
          .select('r2_bucket_name, r2_access_key_id, r2_secret_access_key, r2_endpoint')
          .eq('profile_id', match.profile_id)
          .single();

        if (configErr || !config) {
          console.error('Client config error:', configErr);
          errorMessage = 'La configuración del club no está completa para reproducir este video.';
        } else {
          const dateStr = new Date(match.start_time).toISOString().split('T')[0];
          const courtName = match.courts?.name.replace(/[^a-zA-Z0-9]/g, '_') || 'cancha';
          const filename = `PadelView_${courtName}_${dateStr}.mp4`;
          
          // Generate signed URL dynamically using the club's specific R2 credentials
          signedUrl = await getSignedVideoUrl(match.video_key, filename, {
            endpoint: config.r2_endpoint,
            accessKeyId: config.r2_access_key_id,
            secretAccessKey: config.r2_secret_access_key,
            bucketName: config.r2_bucket_name
          });
        }
      }
    } else if (match.status === 'RECORDING' || match.status === 'UPLOADING') {
      isLoadingState = true;
    } else if (match.status === 'FAILED') {
      errorMessage = 'Hubo un inconveniente técnico al procesar el video de este partido.';
    }
  }
} catch (err: any) {
  console.error('Server loading error:', err);
  errorMessage = err.message || 'Error del servidor al intentar cargar el partido.';
}

const formattedDate = match
  ? new Date(match.start_time).toLocaleDateString('es-AR', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : '';

const formattedTime = match
  ? `${new Date(match.start_time).toLocaleTimeString('es-AR', {
      hour: '2-digit',
      minute: '2-digit'
    })} a ${new Date(match.end_time).toLocaleTimeString('es-AR', {
      hour: '2-digit',
      minute: '2-digit'
    })} hs`
  : '';
---

<Layout title={match ? `Partido de ${match.player_name} - ViewPadel` : 'ViewPadel'}>
  <div class="page-bg" aria-hidden="true">
    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>
    <div class="grid-lines"></div>
  </div>
  <div class="web-container">
    {/* Header */}
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo-link" aria-label="ViewPadel inicio">
          <img src="/View-padel.png" alt="ViewPadel" class="logo-img sm glow-effect" />
          <span class="logo-text">ViewPadel</span>
        </a>
        {match && (
          <div class="court-badge-header">
            <span class="badge-dot"></span>
            {match.courts?.name || 'Cancha Registrada'}
          </div>
        )}
      </div>
    </header>

    {/* Main Card Wrapper */}
    <main class="web-main">
      {/* 1. ERROR STATE */}
      {errorMessage && (
        <div class="status-card error-card">
          <div class="status-icon error-icon">
            <AlertTriangle size={48} />
          </div>
          <h2>¡Ups! Algo no salió bien</h2>
          <p class="error-msg">{errorMessage}</p>
          <div class="support-footer">
            <p>Si consideras que esto es un error, contacta a la administración de tu club.</p>
            <a href="/" class="btn btn-secondary">Volver al inicio</a>
          </div>
        </div>
      )}

      {/* 2. LOADING STATE (RECORDING OR UPLOADING) */}
      {!errorMessage && isLoadingState && match && (
        <div class="status-card loading-card">
          <div class="spinner-container">
            <div class="main-spinner"></div>
            <div class="pulse-dot"></div>
          </div>
          
          <h2>Tu partido se está procesando</h2>
          <p class="status-description">
            {match.status === 'RECORDING' 
              ? 'La cámara está grabando en vivo en este momento.' 
              : 'El video se está subiendo al almacenamiento en la nube.'}
          </p>
          
          <div class="details-box">
            <div class="detail-row">
              <span class="label">Jugador:</span>
              <span class="val">{match.player_name}</span>
            </div>
            <div class="detail-row">
              <span class="label">Horario:</span>
              <span class="val">{formattedTime}</span>
            </div>
            <div class="detail-row">
              <span class="label">Estado actual:</span>
              <span class="val status-pill">
                {match.status === 'RECORDING' ? (
                  <span class="status-indicator live">
                    <span class="pulse-dot-mini"></span>
                    GRABANDO EN VIVO
                  </span>
                ) : (
                  <span class="status-indicator uploading">
                    <Zap size={14} class="spin-slow" />
                    SUBIENDO VIDEO...
                  </span>
                )}
              </span>
            </div>
          </div>
          
          <p class="refresh-hint">Esta página se actualizará automáticamente cuando esté listo.</p>
          
          <script is:inline>
            // Auto refresh every 30 seconds
            setTimeout(() => {
              window.location.reload();
            }, 30000);
          </script>
        </div>
      )}

      {/* 3. DONE STATE - VIDEO PLAYER */}
      {!errorMessage && !isLoadingState && match && signedUrl && (
        <div class="video-container-card">
          {/* Video Player */}
          <div class="video-wrapper">
            <video 
              id="player" 
              controls 
              preload="metadata"
              playsinline
              src={signedUrl}
            >
              Tu navegador no soporta reproducción de video HTML5.
            </video>
          </div>

          {/* Details & Download Options */}
          <div class="video-details-section">
            <div class="match-meta">
              <span class="date">{formattedDate}</span>
              <h2>Partido de {match.player_name}</h2>
              <p class="time-court">{formattedTime} | {match.courts?.name}</p>
            </div>

            <div class="action-buttons">
              <a href={signedUrl} download class="btn primary glass-glow btn-lg">
                <span class="btn-icon">
                  <Download size={18} />
                </span>
                Descargar Video Completo
              </a>
              <button 
                id="share-btn" 
                class="btn ghost tech-border btn-lg"
                onclick={`
                  if(navigator.share) {
                    navigator.share({
                      title: 'Mi partido en ViewPadel',
                      text: '¡Mira la grabación de mi partido en ViewPadel!',
                      url: window.location.href
                    });
                  } else {
                    navigator.clipboard.writeText(window.location.href);
                    alert('¡Enlace copiado al portapapeles!');
                  }
                `}
              >
                <span class="btn-icon">
                  <LinkIcon size={18} />
                </span>
                Compartir Enlace
              </button>
            </div>
          </div>
        </div>
      )}
    </main>

    {/* Footer */}
    <footer class="web-footer">
      <p>© {new Date().getFullYear()} ViewPadel. Todos los derechos reservados.</p>
    </footer>
  </div>
</Layout>



<style>
  :root {
    --cyan:   #00f2fe;
    --green:  #00ff87;
    --bg:     #0d1117;
    --surface:#0f1923;
    --border: rgba(255,255,255,0.07);
    --text:   #f0f6fc;
    --muted:  #cbd5e1;
    --radius: 20px;
    --font-heading: 'Outfit', system-ui, sans-serif;
  }
  /* Base Layout and Container styling */
  .web-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: transparent;
    color: #f8fafc;
    font-family: 'Outfit', sans-serif;
  }

  .web-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background-color: rgba(6, 9, 14, 0.7);
    backdrop-filter: blur(10px);
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: #fff;
  }

  .logo-viewpadel {
    width: 40px;
    height: 40px;
    filter: drop-shadow(0 0 8px rgba(0, 242, 254, 0.85));
    animation: logo-spin-in 2.2s cubic-bezier(0.19, 1, 0.22, 1) forwards;
    transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275), filter 0.3s;
  }

  .logo-viewpadel :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .logo-viewpadel :global(svg path) {
    fill: url(#logo-gradient) !important;
    stroke: url(#logo-gradient) !important;
  }

  .logo-link:hover .logo-viewpadel {
    transform: rotate(360deg);
    filter: drop-shadow(0 0 14px rgba(0, 255, 135, 1));
  }

  @keyframes logo-spin-in {
    0% {
      transform: rotate(-1080deg) scale(0.4);
      opacity: 0;
    }
    100% {
      transform: rotate(0deg) scale(1);
      opacity: 1;
    }
  }

  .logo-text h1 {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .logo-text span {
    font-size: 11px;
    color: #94a3b8;
    letter-spacing: 0.5px;
    display: block;
    margin-top: -1px;
  }

  .court-badge {
    background-color: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #10b981;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
  }

  .web-main {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    max-width: 1000px;
    width: 100%;
    margin: 0 auto;
  }

  /* Status Cards (Error / Loading) */
  .status-card {
    background-color: rgba(22, 29, 49, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 48px 32px;
    text-align: center;
    max-width: 500px;
    width: 100%;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(16px);
  }

  .status-icon {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
  }

  .error-icon {
    color: #ef4444;
  }

  .status-card h2 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .error-msg {
    color: #f87171;
    font-size: 15px;
    margin-bottom: 32px;
  }

  .support-footer p {
    font-size: 13px;
    color: #64748b;
    margin-bottom: 20px;
  }

  /* Spinner & Animations */
  .spinner-container {
    position: relative;
    width: 80px;
    height: 80px;
    margin: 0 auto 24px auto;
  }

  .main-spinner {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    border: 4px solid rgba(16, 185, 129, 0.1);
    border-radius: 50%;
    border-top-color: #10b981;
    animation: spin 1s linear infinite;
  }

  .pulse-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 16px;
    height: 16px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 15px #10b981;
    animation: pulse 1.5s ease infinite;
  }

  .status-description {
    color: #94a3b8;
    font-size: 16px;
    margin-bottom: 24px;
  }

  .details-box {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 16px;
    padding: 16px 20px;
    margin-bottom: 24px;
    text-align: left;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 14px;
  }

  .detail-row:last-child {
    border-bottom: none;
  }

  .detail-row .label {
    color: #64748b;
  }

  .detail-row .val {
    font-weight: 500;
  }

  .detail-row .status-pill {
    color: #38bdf8;
    font-weight: 600;
  }

  .refresh-hint {
    font-size: 13px;
    color: #64748b;
  }

  /* Video Player Container */
  .video-container-card {
    background-color: rgba(22, 29, 49, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    overflow: hidden;
    width: 100%;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #000;
  }

  .video-wrapper video {
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
  }

  .video-details-section {
    padding: 32px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .match-meta .date {
    font-size: 14px;
    color: #10b981;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .match-meta h2 {
    font-size: 26px;
    font-weight: 700;
    margin: 4px 0 8px 0;
    letter-spacing: -0.5px;
  }

  .match-meta .time-court {
    font-size: 15px;
    color: #94a3b8;
  }

  .action-buttons {
    display: flex;
    gap: 16px;
  }

  /* Buttons & Utilities */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    border: none;
  }

  .btn-lg {
    padding: 14px 28px;
    font-size: 16px;
  }

  .btn-primary {
    background-color: #10b981;
    color: #fff;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
  }

  .btn-primary:hover {
    background-color: #059669;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .web-footer {
    text-align: center;
    padding: 24px;
    font-size: 13px;
    color: #64748b;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    background-color: rgba(11, 15, 25, 0.2);
  }

  /* Keyframe animations */
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes pulse {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.9;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.4);
      opacity: 0.45;
    }
  }

  @keyframes pulse-mini {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
      box-shadow: 0 0 8px currentColor;
    }
    50% {
      transform: scale(1.3);
      opacity: 0.6;
      box-shadow: 0 0 14px currentColor;
    }
  }

  .spin-slow {
    animation: spin 3s linear infinite;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  
  .status-indicator.live {
    color: #ef4444;
  }
  
  .status-indicator.uploading {
    color: #38bdf8;
  }

  .pulse-dot-mini {
    width: 8px;
    height: 8px;
    background-color: currentColor;
    border-radius: 50%;
    display: inline-block;
    animation: pulse-mini 1.5s infinite;
  }

  /* Responsive styling */
  @media (max-width: 768px) {
    .web-header {
      padding: 16px 20px;
    }
    
    .logo-icon {
      width: 34px;
      height: 34px;
      font-size: 16px;
    }

    .logo-text h1 {
      font-size: 17px;
    }

    .web-main {
      padding: 20px 12px;
    }

    .video-details-section {
      flex-direction: column;
      align-items: stretch;
      padding: 20px;
      gap: 20px;
    }

    .action-buttons {
      flex-direction: column;
      gap: 12px;
    }

    .match-meta h2 {
      font-size: 22px;
    }
  }

  /* ═══ NEW AMBIENT BACKGROUND ═══ */
  .page-bg {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    z-index: 0; pointer-events: none; overflow: hidden;
    background-color: var(--bg);
  }
  .bg-orb {
    position: absolute; border-radius: 50%; opacity: 0.4;
    will-change: transform;
  }
  .orb-1 { width: 600px; height: 600px; background: radial-gradient(circle, var(--cyan) 0%, transparent 70%); top: -200px; left: -100px; animation: float 15s ease-in-out infinite alternate; }
  .orb-2 { width: 500px; height: 500px; background: radial-gradient(circle, var(--green) 0%, transparent 70%); bottom: -100px; right: -150px; animation: float 18s ease-in-out infinite alternate-reverse; }
  .grid-lines { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(circle at center, black 40%, transparent 100%); -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 100%); }

  /* ═══ NEW HEADER ═══ */
  .site-header { position: sticky; top: 0; z-index: 200; width: 100%; border-bottom: 1px solid var(--border); background: rgba(13,17,23,.5); backdrop-filter: blur(16px); }
  .header-inner { max-width: 1200px; margin: 0 auto; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; }
  .logo-img { width: 36px; height: 36px; transition: transform .7s, filter .3s; }
  .logo-img.sm { width: 28px; height: 28px; }
  .logo-link:hover .logo-img { transform: rotate(360deg); filter: drop-shadow(0 0 12px var(--cyan)); }
  .logo-text { font-size: 19px; font-weight: 800; color: var(--text); font-family: var(--font-heading); }
  
  .court-badge-header { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 99px; background: rgba(0,242,254,.08); border: 1px solid rgba(0,242,254,.3); font-size: 13px; font-weight: 700; color: var(--cyan); box-shadow: 0 0 20px rgba(0,242,254,0.1); }
  .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); animation: blink 2s ease-in-out infinite; }

  /* ═══ NEW CARDS ═══ */
  .video-container-card { background: rgba(13,17,23,.6); border: 1px solid rgba(255,255,255,0.06); border-radius: 24px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); backdrop-filter: blur(20px); }
  .status-card { background: rgba(13,17,23,.6); border: 1px solid rgba(255,255,255,0.06); border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); backdrop-filter: blur(20px); padding: 48px 32px; text-align: center; max-width: 500px; width: 100%; }
  
  /* ═══ NEW BUTTONS ═══ */
  .btn.primary { background: linear-gradient(135deg, var(--cyan), var(--green)); color: #000; border: none; font-weight: 700; }
  .glass-glow:hover { box-shadow: 0 0 24px rgba(0,242,254,.4); transform: translateY(-2px); }
  .btn.ghost { background: rgba(255,255,255,.08); color: var(--text); border: 1px solid rgba(255,255,255,.15); }
  .btn.ghost:hover { background: rgba(255,255,255,.15); transform: translateY(-1px); }
  .tech-border { position: relative; overflow: hidden; }

</style>
