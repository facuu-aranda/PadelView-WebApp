---
interface Props {
  title?: string;
}

const { title = 'ViewPadel - Grabación Inteligente de Partidos' } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
    <!-- Hidden SVG definition for global gradients -->
    <svg width="0" height="0" style="position: absolute; width: 0; height: 0; pointer-events: none;" aria-hidden="true">
      <defs>
        <linearGradient id="logo-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00f2fe" />
          <stop offset="100%" stop-color="#00ff87" />
        </linearGradient>
      </defs>
    </svg>
		<slot />
	</body>
</html>

<style is:global>
  /* Global reset and border box setup */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

	html,
	body {
		margin: 0;
    padding: 0;
		width: 100%;
		min-height: 100%;
    background-color: #0b0f19;
    font-family: 'Outfit', sans-serif;
    overflow-x: hidden; /* Completely prevents horizontal scrolling / layout breaking */
	}

  /* Custom input defaults to prevent shrinking issues on small viewports */
  input, select, button {
    font-family: inherit;
    min-width: 0; /* Prevents overflow inside flex/grid containers */
  }
</style>
